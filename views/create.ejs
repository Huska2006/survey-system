<!DOCTYPE html>
<html>
<head><title>创建问卷</title></head>
<body>
  <h2>创建问卷</h2>
  <input id="title" placeholder="问卷标题" />
  <button onclick="create()">提交并去添加题目</button>
  <div id="addQ" style="display:none; margin-top:20px;">
    <h3>给问卷加题目</h3>
    <select id="type">
      <option value="single">单选</option>
      <option value="text">文本</option>
    </select>
    <input id="qtitle" placeholder="题目内容" />
    <button onclick="addQ()">添加题目</button>
    <button onclick="publish()">发布问卷</button>
  </div>
  <script>
    const token = localStorage.getItem('token');
    let currentSurveyId = null;

    async function create() {
      const res = await fetch('/surveys', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
        body: JSON.stringify({ title: document.getElementById('title').value })
      });
      const data = await res.json();
      currentSurveyId = data._id;
      document.getElementById('addQ').style.display = 'block';
    }

    async function addQ() {
      const type = document.getElementById('type').value;
      const body = {
        type: type,
        title: document.getElementById('qtitle').value,
        options: type === 'single' ? [{key:'A', label:'选项A'}, {key:'B', label:'选项B'}] : undefined
      };
      await fetch('/surveys/' + currentSurveyId + '/questions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
        body: JSON.stringify(body)
      });
      alert('添加成功，可以继续添加或发布');
    }

    async function publish() {
      const res = await fetch('/surveys/' + currentSurveyId + '/publish', {
        method: 'PUT', headers: { 'Authorization': 'Bearer ' + token }
      });
      const data = await res.json();
      if (data.ok) {
        alert('发布成功！去 Dashboard 获取链接吧');
        location.href = '/dashboard';
      } else alert(data.error);
    }
  </script>
</body>
</html>